# ============================================================
# U-GETMO Backend — Environment Variables Example
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# ============================================================

# ---- Server ----
PORT=4002
LOG_FORMAT=dev
LOG_DIR=../logs
ORIGIN=*
CREDENTIALS=true
FRONT_END_URL=http://localhost:3000

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- SendGrid (email) ----
SEND_GRID_API_KEY_1=SG.
SEND_GRID_API_KEY_2=your-api-key-part-2
SEND_GRID_API_KEY_3=your-api-key-part-3

# ---- MySQL Database (mssql) ----
DB_NAME=your-database-name
DB_HOST=your-database-host.example.com
DB_USER=your-db-username
DB_PASSWORD=your-db-password

# ---- JWT ----
JWT_EXPIRES_IN=2h

# ---- Encryption / Secrets ----
SECRET_KEY=your-secret-key-change-me

# ---- AWS ----
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ---- PayFast (payment gateway) ----
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_RETURN_URL=http://localhost:3000/client/profile/orders
PAYFAST_CANCEL_URL=http://localhost:3000/client/cart
PAYFAST_PAYMENT_URL=https://sandbox.payfast.co.za
BACKEND_URL=http://localhost:4002
PAYFAST_TRANSACTION_STATUS_URL=https://api.payfast.co.za/check-payment-status?
PAYFAST_ENV=sandbox
PAYFAST_USE_PRODUCTION=false

# ---- Amrod (supplier) ----
AMROD_USERNAME=your-amrod-username
AMROD_PASSWORD=your-amrod-password
AMROD_CUSTOMER_CODE=000000
AMROD_BASE_URL=https://vendorapi.amrod.co.za
AMROD_LOGIN_URL=https://identity.amrod.co.za/VendorLogin

# ---- Parrot Products (supplier) ----
PARROT_BASE_URL=https://accounts.parrotproducts.biz/PublicWebServices/Customers.svc
PARROT_PRODUCT_FEED_ENDPOINT=/GetCustomerProductFeed/1/your-feed-key/json

# ---- Pricing ----
PRICE_MARKUP_PERCENTAGE=25

# ---- Tarsus (supplier) ----
TARSUS_API_KEY=your-tarsus-api-key
TARSUS_BASE_URL=https://feedgen.tarsusonline.co.za/api/DataFeed/
TARSUS_PRODUCT_FEED_ENDPOINT=Customer-ProductCatalogue
